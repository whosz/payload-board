---
const base = import.meta.env.BASE_URL
---
<section class="section band">
  <div class="container">
    <div class="reveal head">
      <p class="kicker">Look &amp; feel</p>
      <h2>Readable from two metres,<br />compact when you need it</h2>
      <p class="lede">Poster or list view, dark, grey or light theme, a tiny mini mode below 560&nbsp;px — and WCAG&nbsp;2.2&nbsp;AA contrast, visible focus and reduced-motion support throughout.</p>
    </div>
    <div class="grid reveal">
      <div class="shot"><img src={`${base}img/app-list-light.webp`} alt="Payload Board in the light theme, list view" width="2000" height="1250" loading="lazy" /></div>
      <div class="shot mini"><img src={`${base}img/app-mini.webp`} alt="Mini mode: status and the run button in a narrow window" width="640" height="625" loading="lazy" /></div>
    </div>
  </div>
</section>

<style>
  .band { background: linear-gradient(180deg, transparent, var(--surface) 20%, var(--surface) 80%, transparent); }
  .head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  h2 { font-size: clamp(2.4rem, 5.5vw, 4.4rem); margin-bottom: 1.2rem; }
  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 2.6fr); gap: clamp(1.2rem, 3vw, 2.5rem); align-items: center; }
  .mini { max-width: 320px; justify-self: center; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
