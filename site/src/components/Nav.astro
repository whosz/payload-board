---
---
<nav
  class="nav-blur fixed top-0 left-0 right-0 z-50"
  style="height:56px;"
>
  <div
    class="container flex items-center justify-between h-full"
    style="max-width: min(1200px, calc(100% - clamp(2rem, 5vw, 6rem))); margin: 0 auto;"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-white no-underline group">
      <img
        src="/logo.svg"
        alt="Payload Board"
        width="26"
        height="26"
        class="transition-transform duration-300 group-hover:scale-110"
        style="display:block;"
      />
      <span style="font-weight:700; font-size:1rem; letter-spacing:-0.01em;">Payload Board</span>
    </a>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/whosz/payload-board"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2 text-sm transition-colors duration-200"
        style="color: var(--text-2);"
        onmouseover="this.style.color='var(--text)'"
        onmouseout="this.style.color='var(--text-2)'"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        GitHub
      </a>

      <a
        href="https://github.com/whosz/payload-board/releases/latest"
        target="_blank"
        rel="noopener"
        class="btn-pill btn-pill-accent text-sm"
        style="padding: 0.45rem 1.2rem;"
      >
        Download
      </a>
    </div>
  </div>
</nav>
