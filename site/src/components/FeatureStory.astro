---
---
<section style="
  position: relative;
  background:
    radial-gradient(ellipse 55% 45% at 15% 25%, rgba(253,179,30,0.08) 0%, transparent 70%),
    radial-gradient(ellipse 50% 60% at 85% 55%, rgba(140,100,255,0.12) 0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 50% 95%, rgba(6,182,212,0.06) 0%, transparent 70%),
    linear-gradient(180deg, transparent 0%, rgba(59,35,91,0.12) 40%, transparent 100%);
">
  <!-- Section header -->
  <div class="container reveal story-header" style="text-align:center;padding-top:clamp(4rem,8vw,6rem);padding-bottom:clamp(2rem,4vw,3rem);">
    <p style="font-size:0.8rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);margin-bottom:0.75rem;">How it works</p>
    <h2 style="font-size:clamp(1.8rem,3.75vw,3rem);margin:0 0 3.75rem;">
      Everything you need to run<br/>
      <span class="gradient-text-accent">complex workflows</span>
    </h2>
    <!-- Stats bar -->
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1px;
      background: var(--border);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
      max-width: 800px;
      margin: 0 auto;
    ">
      {[
        { value: '~5 MB', label: 'Memory footprint', sub: 'vs ~150 MB for Electron' },
        { value: '< 1s',  label: 'Launch overhead',  sub: 'added per app launch' },
        { value: '∞',     label: 'Apps per profile', sub: 'no artificial limits' },
      ].map((s) => (
        <div style="background:var(--surface);padding:2rem 1.5rem;text-align:center;">
          <div style="font-size:clamp(2.4rem,4.2vw,3.36rem);font-weight:800;letter-spacing:-0.04em;line-height:1;margin-bottom:0.4rem;" class="gradient-text-accent">{s.value}</div>
          <div style="font-size:0.9rem;font-weight:600;color:var(--text);margin-bottom:0.25rem;">{s.label}</div>
          <div style="font-size:0.78rem;color:var(--muted);">{s.sub}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Sticky scroll story -->
  <div id="feature-story" style="
    display: flex;
    gap: clamp(2rem, 5vw, 6rem);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 3rem);
    position: relative;
    align-items: flex-start;
  ">

    <!-- Sticky text column -->
    <div class="story-text-col" style="
      flex: 0 0 clamp(300px, 42%, 480px);
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      align-self: flex-start;
    ">
      <div style="position:relative;width:100%;">

        <!-- Panel 1 -->
        <div class="story-panel" data-panel="0">
          <div style="
            display:inline-flex;align-items:center;justify-content:center;
            width:52px;height:52px;border-radius:14px;
            background: rgba(253,179,30,0.1);
            border:1px solid rgba(253,179,30,0.2);
            margin-bottom:1.5rem;
          ">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fdb31e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);margin-bottom:0.75rem;">01 — Profiles</p>
          <h3 style="font-size:clamp(1.6rem,2.8vw,2.2rem);margin-bottom:1rem;letter-spacing:-0.02em;line-height:1.2;">
            One profile for<br/>every workflow
          </h3>
          <p style="color:var(--text-2);line-height:1.8;font-size:1rem;margin-bottom:1.75rem;">
            Create named profiles with custom emoji icons — iRacing, dev environment,
            streaming setup. Each with its own set of apps and its own order.
          </p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.75rem;">
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(253,179,30,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fdb31e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Emoji icons &amp; descriptions
            </li>
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(253,179,30,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fdb31e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Unlimited profiles
            </li>
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(253,179,30,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fdb31e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Persisted across restarts
            </li>
          </ul>
        </div>

        <!-- Panel 2 -->
        <div class="story-panel" data-panel="1" style="
          position:absolute;top:0;left:0;right:0;
          opacity:0;pointer-events:none;
          transform: translateY(24px);
        ">
          <div style="
            display:inline-flex;align-items:center;justify-content:center;
            width:52px;height:52px;border-radius:14px;
            background: rgba(167,139,250,0.1);
            border:1px solid rgba(167,139,250,0.2);
            margin-bottom:1.5rem;
          ">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35M11 8v6M8 11h6"/>
            </svg>
          </div>
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#a78bfa;margin-bottom:0.75rem;">02 — Discovery</p>
          <h3 style="font-size:clamp(1.6rem,2.8vw,2.2rem);margin-bottom:1rem;letter-spacing:-0.02em;line-height:1.2;">
            Your apps,<br/>already waiting
          </h3>
          <p style="color:var(--text-2);line-height:1.8;font-size:1rem;margin-bottom:1.75rem;">
            Payload Board scans your system for installed apps — Windows registry,
            macOS .app bundles, Linux .desktop files. Pick from a list, no hunting for executables.
          </p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.75rem;">
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(167,139,250,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Windows registry scanner
            </li>
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(167,139,250,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              macOS .app &amp; Linux .desktop support
            </li>
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(167,139,250,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              SteamGridDB artwork, auto-fetched
            </li>
          </ul>
        </div>

        <!-- Panel 3 -->
        <div class="story-panel" data-panel="2" style="
          position:absolute;top:0;left:0;right:0;
          opacity:0;pointer-events:none;
          transform: translateY(24px);
        ">
          <div style="
            display:inline-flex;align-items:center;justify-content:center;
            width:52px;height:52px;border-radius:14px;
            background: rgba(255,107,107,0.1);
            border:1px solid rgba(255,107,107,0.2);
            margin-bottom:1.5rem;
          ">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <p style="font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#ff6b6b;margin-bottom:0.75rem;">03 — Monitoring</p>
          <h3 style="font-size:clamp(1.6rem,2.8vw,2.2rem);margin-bottom:1rem;letter-spacing:-0.02em;line-height:1.2;">
            Always know<br/>what's running
          </h3>
          <p style="color:var(--text-2);line-height:1.8;font-size:1rem;margin-bottom:1.75rem;">
            Green glow means alive. Red pulse means crashed. Dim means stopped.
            Kill everything with one click — no hunting through the taskbar.
          </p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.75rem;">
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(0,208,100,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#00d064" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Live process monitoring
            </li>
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(255,107,107,0.15);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Crash detection with alerts
            </li>
            <li style="display:flex;align-items:center;gap:10px;font-size:0.9rem;color:var(--text-2);">
              <span style="width:20px;height:20px;border-radius:6px;background:rgba(255,255,255,0.05);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#7a7a85" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              One-click End Session
            </li>
          </ul>
        </div>

      </div>
    </div>

    <!-- Right: scroll trigger panels, each 100vh -->
    <div class="story-visual-col" style="flex:1;display:flex;flex-direction:column;">

      <!-- Trigger 1 -->
      <div class="story-trigger" data-trigger="0" style="height:100vh;display:flex;align-items:center;justify-content:center;">
        <div style="
          border-radius: 10px;
          overflow: hidden;
          box-shadow:
            0 0 0 1px rgba(255,255,255,0.07),
            0 24px 60px rgba(0,0,0,0.6);
          max-width: 360px;
          width: 100%;
        ">
          <img
            src={`${import.meta.env.BASE_URL}feature-profiles.png`}
            alt="Payload Board profile list"
            style="width:100%;height:auto;display:block;user-select:none;pointer-events:none;"
            draggable="false"
          />
        </div>
      </div>

      <!-- Trigger 2 -->
      <div class="story-trigger" data-trigger="1" style="height:100vh;display:flex;align-items:center;justify-content:center;">
        <div style="
          border-radius: 10px;
          overflow: hidden;
          box-shadow:
            0 0 0 1px rgba(255,255,255,0.07),
            0 24px 60px rgba(0,0,0,0.6);
          max-width: 400px;
          width: 100%;
        ">
          <img
            src={`${import.meta.env.BASE_URL}feature-discovery.png`}
            alt="Payload Board app discovery"
            style="width:100%;height:auto;display:block;user-select:none;pointer-events:none;"
            draggable="false"
          />
        </div>
      </div>

      <!-- Trigger 3 -->
      <div class="story-trigger" data-trigger="2" style="height:100vh;display:flex;align-items:center;justify-content:center;padding-bottom:clamp(4rem,8vw,6rem);">
        <div style="
          border-radius: 10px;
          overflow: hidden;
          box-shadow:
            0 0 0 1px rgba(255,255,255,0.07),
            0 24px 60px rgba(0,0,0,0.6);
          max-width: 480px;
          width: 100%;
        ">
          <img
            src={`${import.meta.env.BASE_URL}feature-monitoring.png`}
            alt="Payload Board monitoring — alive and crashed tile states"
            style="width:100%;height:auto;display:block;user-select:none;pointer-events:none;"
            draggable="false"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .story-panel {
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }

  /* ── Mobile: drop the screenshot column, stack the panels ──
     The screenshots double as scroll triggers, so hiding them means the
     panels can no longer be swapped — they all get shown at once instead.
     !important is needed because the observer script writes inline styles. */
  @media (max-width: 720px) {
    .story-visual-col { display: none !important; }

    /* Gap between the stats bar and the first story panel.
       !important on both: the header and #feature-story carry inline padding. */
    .story-header {
      padding-bottom: 100px !important;
    }

    #feature-story {
      flex-direction: column;
      padding-bottom: clamp(3rem, 8vw, 5rem) !important;
    }

    .story-text-col {
      position: static !important;
      height: auto !important;
      flex: 1 1 auto !important;
      display: block !important;
    }

    .story-panel {
      position: static !important;
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
      transition: none !important;
    }

    .story-panel + .story-panel {
      margin-top: 3.5rem;
      padding-top: 3.5rem;
      border-top: 1px solid var(--border);
    }
  }

  /* ── Shared app chrome ── */
  .app-panel {
    background: #12101f;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04);
  }
  .app-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6a6a7a;
  }

  /* ── Profile list ── */
  .profile-row {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 12px;
    margin: 2px 4px;
    border-radius: 6px;
    cursor: default;
  }
  .profile-row.active { background: rgba(59,35,91,0.7); }
  .profile-emoji { font-size: 14px; width: 20px; text-align: center; flex-shrink: 0; }
  .profile-name { font-size: 12px; font-weight: 500; color: #b0a9c5; }
  .profile-name.active { font-weight: 600; color: #f0f2f4; }
  .new-profile-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    margin: 4px 4px 8px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    color: #b0a9c5;
    cursor: pointer;
  }

  /* ── Form elements ── */
  .app-input {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 12px;
    color: #f0f2f4;
  }
  .app-input-focus { border-color: #fdb31e; }
  .app-input-placeholder { color: #6a6a7a; }
  .app-btn-outline {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 500;
    color: #b0a9c5;
    cursor: pointer;
    white-space: nowrap;
  }
  .app-btn-active {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.2);
    color: #f0f2f4;
  }
  .app-btn-primary {
    background: #fdb31e;
    border-radius: 5px;
    padding: 7px 14px;
    font-size: 11px;
    font-weight: 700;
    color: #0d0c14;
    cursor: pointer;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  /* ── App tiles ── */
  .app-tile {
    width: 185px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: #12101f;
  }
  .app-tile-crashed {
    border-color: rgba(251,80,96,0.6);
  }
  .tile-bg {
    position: relative;
    height: 115px;
    background-color: #211832;
    background-image:
      repeating-linear-gradient(45deg, rgba(108,65,165,0.18) 0, rgba(108,65,165,0.18) 1px, transparent 0, transparent 50%),
      repeating-linear-gradient(-45deg, rgba(108,65,165,0.18) 0, rgba(108,65,165,0.18) 1px, transparent 0, transparent 50%);
    background-size: 18px 18px;
  }
  .tile-bg-crashed {
    background-color: #1e1227;
  }
  .tile-dot {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .tile-dot-alive {
    background: #00c864;
    box-shadow: 0 0 8px 2px rgba(0,200,100,0.7);
  }
  .tile-dot-crashed {
    background: #fb5060;
    box-shadow: 0 0 8px 2px rgba(251,80,96,0.7);
  }
  .tile-error-text {
    position: absolute;
    top: 8px;
    left: 8px;
    font-size: 9px;
    font-weight: 600;
    color: #fb5060;
    background: rgba(33,28,58,0.85);
    padding: 3px 7px;
    border-radius: 10px;
    white-space: nowrap;
  }
  .tile-footer {
    padding: 8px 10px;
    border-top: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tile-name {
    font-size: 12px;
    font-weight: 600;
    color: #f0f2f4;
  }
  .tile-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLElement>('.story-trigger')
  const panels = document.querySelectorAll<HTMLElement>('.story-panel')

  function setActivePanel(index: number) {
    panels.forEach((panel, i) => {
      const isActive = i === index
      panel.style.opacity = isActive ? '1' : '0'
      panel.style.pointerEvents = isActive ? 'auto' : 'none'
      panel.style.transform = isActive
        ? 'translateY(0)'
        : i < index
        ? 'translateY(-24px)'
        : 'translateY(24px)'
    })
  }

  setActivePanel(0)

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const idx = Number((entry.target as HTMLElement).dataset.trigger)
          setActivePanel(idx)
        }
      })
    },
    { threshold: 0.5 }
  )

  triggers.forEach((t) => observer.observe(t))
</script>
