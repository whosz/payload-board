---
const stats = [
  { value: '~5 MB', label: 'Memory footprint', sub: 'vs ~150 MB for Electron' },
  { value: '< 1s', label: 'Launch overhead', sub: 'per app in the sequence' },
  { value: '∞', label: 'Apps per profile', sub: 'no artificial limits' },
]
---
<section style="padding:clamp(3rem,6vw,5rem) 0;">
  <div class="container">
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1px;
      background: var(--border);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    ">
      {stats.map((s, i) => (
        <div
          class="reveal"
          style={`
            background: var(--surface);
            padding: 2.5rem 2rem;
            text-align: center;
            transition-delay: ${i * 0.1}s;
          `}
        >
          <div style="
            font-size: clamp(2.5rem, 4vw, 3.5rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1;
            margin-bottom: 0.4rem;
          " class="gradient-text-accent">{s.value}</div>
          <div style="font-size:0.95rem;font-weight:600;color:var(--text);margin-bottom:0.3rem;">{s.label}</div>
          <div style="font-size:0.8rem;color:var(--muted);">{s.sub}</div>
        </div>
      ))}
    </div>
  </div>
</section>
