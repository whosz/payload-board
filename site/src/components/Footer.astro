---
const base = import.meta.env.BASE_URL
---
<footer>
  <div class="container row">
    <a href={base} class="brand"><img src={`${base}logo.svg`} alt="" width="20" height="20" /><span>Payload Board</span></a>
    <p>Built with Tauri &amp; React &nbsp;·&nbsp; MIT License</p>
    <a class="gh" href="https://github.com/whosz/payload-board" target="_blank" rel="noopener">whosz/payload-board</a>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); padding: 2rem 0; }
  .row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: 0.5rem; color: var(--text-2); text-decoration: none;
    font-family: var(--font-display); font-weight: 900; font-size: 1.05rem; letter-spacing: 0.12em; text-transform: uppercase; }
  p { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .gh { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); text-decoration: none; }
  .gh:hover { color: var(--text-2); }
</style>
