---
const features = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>`,
    title: 'SteamGridDB',
    description: 'Pull in gorgeous game artwork for your app tiles automatically.',
    accent: '#a78bfa',
    bg: 'rgba(167,139,250,0.07)',
    border: 'rgba(167,139,250,0.15)',
    delay: '0.1',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Cross-Platform',
    description: 'Windows installer and portable builds. macOS and Linux supported.',
    accent: '#f59e0b',
    bg: 'rgba(245,158,11,0.07)',
    border: 'rgba(245,158,11,0.15)',
    delay: '0.2',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
    title: 'Real-Time Monitor',
    description: 'See every process state at a glance. Catch crashes before they ruin your session.',
    accent: '#ec4899',
    bg: 'rgba(236,72,153,0.07)',
    border: 'rgba(236,72,153,0.15)',
    delay: '0.3',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    title: 'Open Source',
    description: 'MIT licensed, built with React and TypeScript. Audit it, fork it, contribute.',
    accent: '#06b6d4',
    bg: 'rgba(6,182,212,0.07)',
    border: 'rgba(6,182,212,0.15)',
    delay: '0.4',
  },
]
---
<section class="section" style="background:linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.015) 50%, transparent 100%);">
  <div class="container">
    <div class="reveal" style="text-align:center;margin-bottom:clamp(2.5rem,5vw,4rem);">
      <p style="font-size:0.8rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);margin-bottom:0.75rem;">Features</p>
      <h2 style="font-size:clamp(1.8rem,3.5vw,2.8rem);margin:0;">
        Built for power users who<br/>
        <span class="gradient-text">mean business</span>
      </h2>
    </div>

    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    ">
      {features.map((f) => (
        <div
          class="feature-card reveal"
          style={`transition-delay:${f.delay}s;`}
        >
          <div style={`
            display:inline-flex;align-items:center;justify-content:center;
            width:44px;height:44px;border-radius:12px;
            background:${f.bg};
            border:1px solid ${f.border};
            margin-bottom:1rem;
          `} set:html={f.icon} />
          <h3 style={`font-size:1rem;font-weight:700;margin-bottom:0.4rem;color:${f.accent};`}>{f.title}</h3>
          <p style="font-size:0.875rem;color:var(--text-2);line-height:1.6;margin:0;">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
