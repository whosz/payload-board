---
const features = [
  ['Sequencer in Rust', 'Order, delays, progress and cancel — running in the backend, so it survives a hidden window.'],
  ['Crash alerts', 'A system notification when an app dies, and optional auto-restart with a retry limit, per app.'],
  ['Command palette', 'Ctrl+K: start apps, switch profiles, run actions. Keyboard-first and screen-reader friendly.'],
  ['Global shortcuts', 'Work while a game has focus. Fully configurable, conflicts reported, End session needs a second press.'],
  ['Game artwork', 'Tile art from SteamGridDB or any local image; profile accent colour and cover.'],
  ['Steam-aware', 'Pick installed apps — Steam games resolve to the real game executable through Steam\'s manifests.'],
  ['Five languages', 'English, Polski, Deutsch, Español, Français — switch in Settings.'],
  ['Tray & autostart', 'Start minimised, minimise on close, launch on startup. A tiny Tauri app: about 5 MB of RAM.'],
]
---
<section class="section">
  <div class="container">
    <div class="reveal head">
      <p class="kicker">And more</p>
      <h2>Small app.<br />Serious about details.</h2>
    </div>
    <div class="grid">
      {features.map(([title, text], i) => (
        <div class="card reveal" style={`transition-delay:${(i % 4) * 0.06}s`}>
          <span class="idx">{String(i + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  h2 { font-size: clamp(2.4rem, 5.5vw, 4.4rem); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
  .idx { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; color: var(--accent); }
</style>
