---
// Figma nodes 56:824 and 59:1414 — crossfade every 10s.
---

<div style="
  max-width: 920px;
  margin: 0 auto;
  border-radius: 10px;
  overflow: hidden;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.07),
    0 40px 80px rgba(0,0,0,0.6),
    0 80px 160px rgba(0,0,0,0.3);
  position: relative;
">
  <img
    id="app-img-a"
    src={`${import.meta.env.BASE_URL}app-ui.png`}
    alt="Payload Board app interface"
    style="width:100%;height:auto;display:block;user-select:none;pointer-events:none;transition:opacity 1s ease;"
    draggable="false"
  />
  <img
    id="app-img-b"
    src={`${import.meta.env.BASE_URL}app-ui-2.png`}
    alt="Payload Board app interface"
    style="width:100%;height:auto;display:block;user-select:none;pointer-events:none;transition:opacity 1s ease;opacity:0;position:absolute;top:0;left:0;"
    draggable="false"
  />
</div>

<script>
  const a = document.getElementById('app-img-a') as HTMLImageElement
  const b = document.getElementById('app-img-b') as HTMLImageElement
  let showingA = true

  setInterval(() => {
    showingA = !showingA
    a.style.opacity = showingA ? '1' : '0'
    b.style.opacity = showingA ? '0' : '1'
  }, 10000)
</script>
