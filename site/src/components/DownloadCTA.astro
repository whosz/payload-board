---
const base = import.meta.env.BASE_URL
const dl = 'https://github.com/whosz/payload-board/releases/latest'
---
<section class="section cta" id="download">
  <img class="bg" src={`${base}img/bg-cta.webp`} alt="" width="1920" height="1080" loading="lazy" />
  <div class="shade"></div>
  <div class="container inner">
    <img class="reveal" src={`${base}logo.svg`} alt="" width="56" height="56" />
    <h2 class="reveal">Your setup,<br /><span class="accent">on command.</span></h2>
    <p class="lede reveal">Free and open source, no account, no telemetry — the only network call is an update check against GitHub that you can switch off.</p>
    <div class="actions reveal">
      <a href={dl} target="_blank" rel="noopener" class="btn btn-accent">Download for Windows</a>
      <a href={dl} target="_blank" rel="noopener" class="btn">Linux · .deb / .AppImage</a>
    </div>
    <p class="small">Windows 10/11 (64-bit) · Windows may show a SmartScreen warning on first run: “More info → Run anyway”.</p>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; text-align: center; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.65; }
  .shade { position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(18, 18, 17, 0.55), var(--bg) 100%), linear-gradient(180deg, var(--bg) 0%, transparent 30%, transparent 70%, var(--bg) 100%); }
  .inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  h2 { font-size: clamp(3rem, 8vw, 6.5rem); margin: 1.4rem 0 1.2rem; }
  .accent { color: var(--accent); }
  .lede { margin: 0 auto 2.2rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; }
  .small { margin: 1.4rem 0 0; font-size: 0.88rem; color: var(--muted); max-width: 34rem; }
</style>
