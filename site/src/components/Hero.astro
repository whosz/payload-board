---
const base = import.meta.env.BASE_URL
const dl = 'https://github.com/whosz/payload-board/releases/latest'
---
<section class="hero">
  <img class="hero-bg" src={`${base}img/bg-hero.webp`} alt="" width="1920" height="1080" fetchpriority="high" />
  <div class="hero-fade"></div>

  <div class="container hero-inner">
    <p class="kicker">v0.6.0 &nbsp;·&nbsp; Windows &amp; Linux &nbsp;·&nbsp; Free &amp; open source</p>
    <h1>
      Launch your stack.<br />
      <span class="accent">In the right order.</span>
    </h1>
    <p class="lede">
      Group your apps into profiles, start them in sequence with one click, and see every process's live status.
      Built for sim racing rigs, dev setups and streaming — anything that has to start in a certain order.
    </p>
    <div class="hero-cta">
      <a href={dl} target="_blank" rel="noopener" class="btn btn-accent">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download for Windows
      </a>
      <a href="#features" class="btn">See what it does</a>
    </div>
    <p class="hero-note">Linux builds (<code>.deb</code>, <code>.AppImage</code>) are on the <a href={dl} target="_blank" rel="noopener">release page</a>.</p>

    <div class="shot hero-shot">
      <img src={`${base}img/app-hero.webp`} alt="Payload Board: the Sim Racing profile with five apps, three running and one crashed" width="2200" height="1375" />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: calc(60px + clamp(3.5rem, 8vw, 6rem)) 0 clamp(3rem, 6vw, 5rem); }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 40%; opacity: 0.55; }
  .hero-fade { position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 60% at 25% 35%, transparent 0%, var(--bg) 85%), linear-gradient(180deg, transparent 55%, var(--bg) 100%); }
  .hero-inner { position: relative; z-index: 1; }
  h1 { font-size: clamp(3.4rem, 9.5vw, 8rem); margin-bottom: 1.5rem; }
  .accent { color: var(--accent); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; }
  .hero-note { margin: 1rem 0 0; font-size: 0.9rem; color: var(--muted); }
  .hero-note a { color: var(--text-2); }
  code { font-family: var(--font-mono); font-size: 0.85em; }
  .hero-shot { margin-top: clamp(2.5rem, 6vw, 4.5rem); }
</style>
