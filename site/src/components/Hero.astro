---
import AppMockup from './AppMockup.astro'

const leftIcons = [
  { emoji: '🏎️', top: '12%',  left: '4%',  size: 52, delay: 0.2, rotate: -8 },
  { emoji: '⚙️',  top: '28%',  left: '9%',  size: 44, delay: 0.35, rotate: 6 },
  { emoji: '🎧',  top: '46%',  left: '3%',  size: 48, delay: 0.5,  rotate: -4 },
  { emoji: '🕹️',  top: '64%',  left: '8%',  size: 42, delay: 0.65, rotate: 5 },
]

const rightIcons = [
  { emoji: '🖥️',  top: '10%',  right: '5%',  size: 50, delay: 0.25, rotate: 7 },
  { emoji: '📊',  top: '27%',  right: '8%',  size: 44, delay: 0.4,  rotate: -6 },
  { emoji: '🎮',  top: '45%',  right: '3%',  size: 48, delay: 0.55, rotate: 4 },
  { emoji: '🚗',  top: '63%',  right: '7%',  size: 42, delay: 0.7,  rotate: -5 },
]
---
<section
  style="
    padding-top: calc(56px + clamp(3rem, 6vw, 5rem));
    padding-bottom: clamp(4.5rem, 9vw, 7.5rem);
    text-align: center;
    position: relative;
    overflow: hidden;
  "
>
  <!-- Background glow -->
  <div style="
    position: absolute;
    top: 56px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse at center, rgba(253,179,30,0.06) 0%, transparent 70%);
    pointer-events: none;
  "></div>

  <!-- Floating left icons -->
  {leftIcons.map((ic) => (
    <div style={`
      position: absolute;
      top: ${ic.top};
      left: ${ic.left};
      font-size: ${ic.size}px;
      line-height: 1;
      --r: ${ic.rotate}deg;
      opacity: 0;
      animation: iconFloat 0.8s var(--ease-snap) ${ic.delay}s forwards;
      pointer-events: none;
      user-select: none;
      filter: drop-shadow(0 4px 16px rgba(0,0,0,0.5));
    `}>{ic.emoji}</div>
  ))}

  <!-- Floating right icons -->
  {rightIcons.map((ic) => (
    <div style={`
      position: absolute;
      top: ${ic.top};
      right: ${ic.right};
      font-size: ${ic.size}px;
      line-height: 1;
      --r: ${ic.rotate}deg;
      opacity: 0;
      animation: iconFloat 0.8s var(--ease-snap) ${ic.delay}s forwards;
      pointer-events: none;
      user-select: none;
      filter: drop-shadow(0 4px 16px rgba(0,0,0,0.5));
    `}>{ic.emoji}</div>
  ))}

  <div class="container" style="position:relative;z-index:1;">

    <!-- App logo + name -->
    <div style="
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1rem;
      animation: wordIn 0.7s var(--ease-snap) 0.2s both;
    ">
      <div style="
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg, #1e1810 0%, #12100a 100%);
        border: 1px solid rgba(253,179,30,0.2);
        box-shadow: 0 0 30px rgba(253,179,30,0.1);
      ">
        <img src="/logo.svg" alt="Payload Board" width="34" height="34" style="display:block;" />
      </div>
      <span style="font-size:0.95rem;font-weight:700;color:var(--text);letter-spacing:-0.01em;">Payload Board</span>
    </div>

    <!-- Badge -->
    <div style="
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(253,179,30,0.08);
      border: 1px solid rgba(253,179,30,0.2);
      font-size: 11px;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      animation: wordIn 0.7s var(--ease-snap) 0.35s both;
    ">
      <span style="width:5px;height:5px;border-radius:50%;background:var(--accent);display:inline-block;"></span>
      Free & Open Source
    </div>

    <!-- Headline -->
    <h1 style="
      font-size: clamp(2.4rem, 5.5vw, 4.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
      margin-bottom: 1.5rem;
    ">
      <span class="gradient-text" style="display:block;overflow:hidden;padding-bottom:0.05em;"><span class="hero-word" style="animation-delay: 0.5s;">Launch</span> <span class="hero-word" style="animation-delay: 0.62s;">your</span> <span class="hero-word" style="animation-delay: 0.74s;">stack.</span></span>
      <span style="display:block;color:#ffffff;overflow:hidden;padding-bottom:0.05em;"><span class="hero-word" style="animation-delay: 0.9s;">In</span> <span class="hero-word" style="animation-delay: 1.0s;">the</span> <span class="hero-word" style="animation-delay: 1.1s;">right</span> <span class="hero-word" style="animation-delay: 1.2s;">order.</span></span>
    </h1>

    <!-- Subtext -->
    <p style="
      font-size: clamp(1rem, 1.8vw, 1.2rem);
      color: var(--text-2);
      max-width: 540px;
      margin: 0 auto 2.5rem;
      line-height: 1.7;
      font-weight: 400;
      animation: wordIn 0.8s var(--ease-snap) 1.3s both;
    ">
      Group your apps into profiles, fire them in sequence,
      and monitor every process in real time.
    </p>

    <!-- CTAs -->
    <div style="
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      animation: wordIn 0.8s var(--ease-snap) 1.5s both;
    ">
      <a
        href="https://github.com/whosz/payload-board/releases/latest"
        target="_blank"
        rel="noopener"
        class="btn-pill btn-pill-accent"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download for Windows
      </a>
      <a
        href="https://github.com/whosz/payload-board"
        target="_blank"
        rel="noopener"
        class="btn-pill btn-pill-ghost"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        View on GitHub
      </a>
    </div>

    <!-- Mockup -->
    <div style="
      margin-top: clamp(3rem, 6vw, 5rem);
      animation: wordIn 1s var(--ease-snap) 1.7s both;
    ">
      <AppMockup />
    </div>
  </div>
</section>

<style>
  @keyframes iconFloat {
    from { opacity: 0; transform: rotate(var(--r, 0deg)) translateY(12px); }
    to   { opacity: 0.7; transform: rotate(var(--r, 0deg)) translateY(0); }
  }
</style>
